[
  {
    "ignores": [
      "dist/**",
      ".quality-build/**",
      "coverage/**",
      "node_modules/**"
    ]
  },
  {
    "files": ["**/*.ts"],
    "languageOptions": {
      "parserOptions": {
        "projectService": true
      }
    }
  },
  {
    "linterOptions": {
      "noInlineConfig": true,
      "reportUnusedDisableDirectives": "error",
      "reportUnusedInlineConfigs": "error"
    },
    "rules": {
      "no-console": "error",
      "no-warning-comments": [
        "error",
        { "terms": ["todo", "fixme", "xxx"], "location": "anywhere" }
      ],
      "@typescript-eslint/ban-ts-comment": [
        "error",
        {
          "ts-ignore": true,
          "ts-nocheck": true,
          "ts-expect-error": true,
          "ts-check": false
        }
      ],
      "complexity": ["error", 10],
      "sonarjs/cognitive-complexity": ["error", 5],
      "max-lines": [
        "error",
        {
          "max": 399,
          "skipBlankLines": false,
          "skipComments": false
        }
      ]
    }
  },
  {
    "files": ["tests/**/*.ts"],
    "rules": {
      "vitest/no-focused-tests": "error",
      "vitest/no-disabled-tests": "error",
      "vitest/warn-todo": "error",
      "vitest/no-import-node-test": "error",
      "vitest/no-test-prefixes": "error",
      "vitest/no-commented-out-tests": "error",
      "no-restricted-syntax": [
        "error",
        {
          "selector": "MemberExpression:matches([property.name=/^(fails|skipIf|runIf)$/],[property.value=/^(fails|skipIf|runIf)$/])",
          "message": "Tests must run unconditionally and pass normally."
        },
        {
          "selector": "Property:matches([key.name=/^(retry|repeats)$/],[key.value=/^(retry|repeats)$/]):not([value.type='Literal'][value.value=0])",
          "message": "Test retries and repetitions must remain zero."
        },
        {
          "selector": "Property:matches([key.name=/^(only|skip|todo|fails)$/],[key.value=/^(only|skip|todo|fails)$/]):not([value.type='Literal'][value.value=false])",
          "message": "Test focus, suppression and expected failure options are forbidden."
        }
      ]
    }
  }
]
