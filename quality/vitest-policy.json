{
  "test": {
    "include": ["tests/**/*.test.ts"],
    "coverage": {
      "provider": "v8",
      "include": [
        "src/**/*.ts",
        "quality/**/*.ts",
        "vitest.config.ts",
        "eslint.config.mjs",
        "dependency-policy.mjs",
        "dependency-main.mjs"
      ],
      "thresholds": {
        "lines": 100,
        "branches": 100,
        "functions": 100,
        "statements": 100
      }
    },
    "allowOnly": false,
    "passWithNoTests": false,
    "retry": 0
  }
}
