{
  "test": {
    "include": ["tests/**/*.test.ts"],
    "coverage": {
      "provider": "v8",
      "include": [
        "src/**/*.ts",
        "quality/**/*.ts",
        "vitest.config.ts",
        "eslint.config.mjs",
        "dependency-policy.mjs",
        "dependency-main.mjs"
      ],
      "thresholds": {
        "lines": 100,
        "branches": 100,
        "functions": 100,
        "statements": 100
      }
    },
    "allowOnly": false,
    "passWithNoTests": false,
    "retry": 0,
    "maxWorkers": 2,
    "setupFiles": ["tests/runtime-setup.ts"],
    "reporters": ["default", "json", "./quality/diagnostics-reporter.ts"],
    "outputFile": ".quality-results/tests.json",
    "dangerouslyIgnoreUnhandledErrors": false
  }
}
