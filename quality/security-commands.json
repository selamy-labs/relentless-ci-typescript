{
  "history": [
    "gitleaks",
    "git",
    ".",
    "--no-banner",
    "--redact",
    "--ignore-gitleaks-allow",
    "--config",
    "quality/gitleaks.toml",
    "--gitleaks-ignore-path",
    "quality/gitleaks.ignore",
    "--report-format",
    "json",
    "--report-path",
    "{report}"
  ],
  "tree": [
    "gitleaks",
    "dir",
    ".",
    "--no-banner",
    "--redact",
    "--ignore-gitleaks-allow",
    "--config",
    "quality/gitleaks.toml",
    "--gitleaks-ignore-path",
    "quality/gitleaks.ignore",
    "--report-format",
    "json",
    "--report-path",
    "{report}"
  ],
  "audit": [
    "osv-scanner",
    "scan",
    "source",
    "--lockfile",
    "{lockfile}",
    "--config",
    "quality/osv-scanner.toml",
    "--all-vulns",
    "--all-packages",
    "--format",
    "json",
    "--output-file",
    "{report}"
  ],
  "sast": [
    "opengrep",
    "scan",
    "--config",
    "quality/security.yml",
    "--error",
    "--strict",
    "--disable-nosem",
    "--disable-version-check",
    "--taint-intrafile",
    "--x-ignore-semgrepignore-files",
    "--no-git-ignore",
    "--max-target-bytes",
    "0",
    "--json",
    "--output",
    "{report}"
  ]
}
