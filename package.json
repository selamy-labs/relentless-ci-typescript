{
  "name": "relentless-ci-typescript",
  "version": "0.1.0",
  "description": "A strict, framework-neutral TypeScript starting point",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "relentless-example": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.quality.json && vitest run --config .quality-build/quality/vitest-config.js",
    "coverage": "tsc -p tsconfig.quality.json && vitest run --config .quality-build/quality/vitest-config.js --coverage",
    "lint": "eslint --max-warnings 0 --no-ignore src tests quality eslint.config.mjs dependency-policy.mjs dependency-main.mjs",
    "format:check": "prettier --check src tests quality *.json *.mjs",
    "mutation": "npm run build && tsc -p tsconfig.quality.json && stryker run && node .quality-build/quality/check-mutation-main.js",
    "deadcode": "knip",
    "scope": "tsc -p tsconfig.quality.json && node .quality-build/quality/check-source-main.js",
    "hygiene": "tsc -p tsconfig.quality.json && node .quality-build/quality/hygiene-main.js",
    "verify": "npm run dependency-policy && npm ci --ignore-scripts && tsc -p tsconfig.quality.json && node .quality-build/quality/docker-main.js",
    "verify:installed": "tsc -p tsconfig.quality.json && node .quality-build/quality/verify-main.js",
    "architecture": "depcruise --no-ignore-known --no-cache --config quality/architecture.json --output-type err-long src tests quality eslint.config.mjs dependency-policy.mjs dependency-main.mjs",
    "dependency-policy": "node dependency-main.mjs",
    "package:check": "tsc -p tsconfig.quality.json && node .quality-build/quality/package-main.js",
    "workflows": "tsc -p tsconfig.quality.json && node .quality-build/quality/workflow-main.js",
    "support:check": "tsc -p tsconfig.quality.json && node .quality-build/quality/support-main.js",
    "runtime:check": "tsc -p tsconfig.quality.json && node .quality-build/quality/runtime-support-main.js",
    "documentation": "tsc -p tsconfig.quality.json && node .quality-build/quality/documentation-main.js",
    "duplication": "tsc -p tsconfig.quality.json && node .quality-build/quality/duplication-main.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fast-check": "^4.10.2",
    "github-slugger": "2.0.0",
    "jsonc-parser": "3.3.1",
    "knip": "^6.38.0",
    "markdownlint": "0.41.1",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "prettier": "^3.9.9",
    "smol-toml": "1.9.0",
    "tar": "7.5.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "unist-util-visit": "5.1.0",
    "vitest": "^5.0.2",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  }
}
