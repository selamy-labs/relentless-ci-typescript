{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/**/*.ts",
    "quality/**/*.ts",
    "eslint.config.mjs",
    "dependency-policy.mjs",
    "dependency-main.mjs"
  ],
  "testRunner": "vitest",
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "json", "event-recorder"],
  "jsonReporter": {
    "fileName": ".quality-results/mutation.json"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "concurrency": 2,
  "incremental": false,
  "eventReporter": {
    "baseDir": ".quality-results/mutation-events"
  },
  "vitest": {
    "configFile": "quality/vitest-config.ts"
  }
}
